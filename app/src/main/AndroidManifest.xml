<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Exact alarms. USE_EXACT_ALARM is granted at install and is the one meant
      for alarm- and reminder-class apps, which this is; SCHEDULE_EXACT_ALARM
      covers 12 and 13, where it can be refused and the refusal is silent.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 13+ runtime grant. Denied means the alarm fires and nobody sees it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AlarmManager forgets everything on reboot, with no warning to anyone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets the alarm appear over the lock screen instead of queueing behind it.
      On 14+ this is auto-granted only to alarm- and call-class apps; anywhere
      else it degrades to an ordinary heads-up rather than failing.
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!--
      Lets the app ask, in one tap, to stop being battery-optimised. Observed
      necessary on XOS, where the app is frozen with the screen off and alarms
      arrive only when it thaws.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".spike.SpikeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linodea">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Linodea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not exported: only AlarmManager delivers to these, and an exported
          receiver would let any app on the device forge a firing and corrupt
          the results.
        -->
        <receiver
            android:name=".spike.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".spike.BootReceiver"
            android:exported="false"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
