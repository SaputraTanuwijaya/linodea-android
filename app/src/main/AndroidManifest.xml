<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Exact alarms. USE_EXACT_ALARM is granted at install and is the one meant
      for alarm- and reminder-class apps, which this is; SCHEDULE_EXACT_ALARM
      covers 12 and 13, where it can be refused and the refusal is silent.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Android 13+ runtime grant. Denied means the alarm fires and nobody sees it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AlarmManager forgets everything on reboot, with no warning to anyone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets the app ask, in one tap, to stop being battery-optimised. Observed
      necessary on XOS, where the app is frozen with the screen off and alarms
      arrive only when it thaws.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Holds the process out of the freezer. Needed because on XOS the three
      available settings were not enough: alarms still queued behind a frozen
      app until it was opened by hand. `specialUse` is the honest type: this
      is not sync, media or location, it is "stay resident so an alarm can be
      delivered".
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      The calendar path: write a reminder into a calendar that exists only on
      this phone, and read back what the calendar did with it. Asked for at
      runtime; refusing it leaves that one path untested and the rest working.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- The control: asks the phone's own Clock app to ring at the same minute. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
      Android 11+ hides other apps unless asked about. These two questions are
      "which apps are told about calendar reminders" (shown on the setup card,
      because if none are, no calendar app will show its own notification) and
      "is there a Clock app to set the control alarm".
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.EVENT_REMINDER" />
            <data android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
    </queries>

    <application
        android:name=".spike.SpikeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Linodea">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Linodea">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".spike.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the process resident so exact alarms are delivered on OEM builds that freeze cached apps" />
        </service>

        <!--
          Not exported: only AlarmManager delivers to this, and an exported
          receiver would let any app on the device forge a firing and corrupt
          the results.
        -->
        <receiver
            android:name=".spike.AlarmReceiver"
            android:exported="false" />

        <!--
          Exported, and has to be: the sender is Android's calendar storage,
          another app. The receiver trusts the broadcast for its timing only
          and checks it against its own record (see the class).
        -->
        <receiver
            android:name=".spike.CalendarReminderReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data android:scheme="content" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".spike.BootReceiver"
            android:exported="false"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
